  "events": {
    "schema": "drift-town.events",
    "version": 1,
    "summary": "通用事件表结构。npc.eventsAffinity 里的条目是这一结构的实例；这里给出字段定义、枚举与全局冷却规则，供后台直接渲染与校验。",
    "fields": {
      "id": "唯一键",
      "npcId": "关联 npcs[].id，可为 null 表示与具体 NPC 无关的环境事件",
      "eventType": "help | trade | conflict | story",
      "title": "事件标题（玩家可见）",
      "trigger": "触发条件对象，见 triggerTypes",
      "weight": "随机触发时的相对权重；条件不满足则不参与抽取",
      "choices": "选项数组，每项含 text 与 result",
      "cooldown": "同一事件再次触发的冷却，单位游戏日；0 表示一次性事件",
      "once": "是否一次性事件"
    },
    "triggerTypes": {
      "time": "指定游戏日 / 时段（slot: day | dusk | night）",
      "progress": "进度里程碑（townLevel / reputation / 已建成建筑数）",
      "affinity": "某 NPC 好感度达到阈值",
      "random": "在满足其它条件时按 weight 随机",
      "building": "指定建筑建成时"
    },
    "resultShape": "result 可能含：affinity（好感度增减）、resource（资源增减）、unlock（解锁标记）、message（一句反馈文本）。数值口径与 game.js 的资源键一致。",
    "eventsList": [
      {
        "id": "evt-driftwood-gift",
