{
  "schema": "drift-town.npcs",
  "version": 1,
  "updatedAt": "2026-11-22",
  "title": "NPC 与事件表",
  "summary": "六位流浪者的小传、特长、招募条件、出现时机与好感度事件链，外加一张可复用的通用事件表结构。人和事件是两张表，用 npcId 关联。",
  "sourceOfTruth": {
    "roster": "docs/GAME_DESIGN.md · 阶段 3 · 3.1 NPC 类型（首批 6 位）表格",
    "recruitGating": "docs/UNLOCK_CHAIN.md · 一、解锁链全图 阶段 3",
    "eventShape": "docs/GAME_DESIGN.md · 6.3 模块四（触发条件 / 类型 / 选项与结果 / 冷却）"
  },
  "notes": [
    "recruitCondition 拆成两类键：hard 是必须全部满足的硬门槛（对应文档的「招募条件」列），personality 是「人格化任务」，用来规避风险 R4「NPC 招募变成纯数值门槛」。两者分开存，后台可以分别校验。",
    "appearTiming 用 { type, value } 而不是纯字符串，因为「第 N 天」和「建成某建筑后」需要程序判定，而不是人读。",
    "unlocks 只写「这个人带来什么玩法解锁」，具体数值效果落在 specialties.effects 里，避免同一件事两处记录。",
    "affinityEvents 是这位 NPC 专属的好感度事件链，通用事件规则见文件末尾 events 表；两者用 eventType 对齐，冷却单位统一为游戏日。",
    "portrait 用 PROC: 前缀表示程序化绘制（当前项目全部角色都是体素/Canvas 绘制，没有 PNG 立绘），这是与 assets 目录解耦的约定。",
    "legacy 记录 NPC 来之前的事。它是叙事资产，也是莉莉这类 NPC 收费逻辑的动机来源，不是空字段。"
  ],
  "enums": {
    "specialty": {
      "salvage": "打捞",
      "build": "建造",
      "cook": "烹饪",
      "dive": "潜水",
      "run": "经营",
      "story": "剧情"
    },
    "eventType": {
      "help": "求助：NPC 要东西 / 要条件",
      "trade": "交易：一口价交换",
      "conflict": "冲突：两个居民起矛盾，需要裁决",
      "story": "剧情：推进世界观与沉城线索"
    },
    "recruitConditionType": {
      "resource": "交付指定数量的资源",
      "building": "已建成某座建筑",
      "tool": "已拥有某件装备",
      "reputation": "声望达到某级",
      "townLevel": "城镇等级达到某级"
    },
    "appearTimingType": {
      "gameDay": "第 N 个游戏日起可出现",
      "afterBuilding": "某建筑建成后可出现",
      "afterRecruit": "某 NPC 已招募后可出现"
    }
  },
  "npcs": [
    {
      "id": "laochen",
      "name": "老陈",
      "portrait": "PROC:laochen",
      "title": "捞了四十年的老手",
      "specialty": "salvage",
      "bio": "大潮前是渔船上的水手，大潮后是海上最会看垃圾往哪漂的人。话少，手快，说「这玩意儿有用」的时候基本都对。",
      "legacy": "他原来的船叫「陈记二号」，沉在离这里两天航程的地方。他从不提船，只提船上那口锅。",
      "recruitCondition": {
        "hard": [
          {
            "type": "resource",
            "key": "wood",
            "amount": 20,
            "text": "交付木×20"
          }
        ],
        "personality": {
          "id": "laochen-net",
          "text": "他要你陪他把一张破网补完——不是交东西，是花时间。补网时他会顺手教你分辨哪种漂浮物值得捞。",
          "check": "完成补网小游戏（3 次正确补洞）"
        }
      },
      "appearTiming": {
        "type": "gameDay",
        "value": 2,
        "text": "第 2 个游戏日起，每 1–2 日可出现 1 位"
      },
      "unlocks": [
        "自动打捞（离线收益）"
      ],
      "specialties": {
        "desc": "自动打捞",
        "effects": {
          "offlineSalvagePerHour": 40,
          "salvageRangeBonus": 0.15
