{
  "schema": "drift-town.resources",
  "version": 1,
  "updatedAt": "2026-11-22",
  "title": "资源与海洋图鉴表",
  "summary": "游戏与运营后台共用的唯一资源真相来源。海面可打捞物、潜水食材、沉城残骸与人类装备都在这一张表里。",
  "sourceOfTruth": {
    "surfacePickups": "game.js · PICKUP_KINDS（7 种垃圾的 name / res / value / glow）",
    "surfaceSpawnWeights": "game.js · addPickup() 里 var roll = Math.random() * 12 的概率区间宽度",
    "craftRecipes": "docs/GAME_DESIGN.md · 6.2 关键装备解锁链",
    "tiers": "docs/GAME_DESIGN.md · 6.1 四层稀有度与海域绑定"
  },
  "notes": [
    "本文件是合法严格 JSON，不含注释；所有说明放在 notes / 字段旁边的 text 里。",
    "spawnWeight 的口径：海面打捞物的 7 个权重之和恰为 12，等价于 game.js 中 Math.random()*12 的区间宽度。改这些数字即可在不发版的情况下调整海面垃圾的比例。",
    "yield 只使用 enums.yieldKeys 中列出的材料键；目前游戏内经济只有 wood / plastic / metal 三条线，food 是可直接入口的食材，salvage（稀有残件）是寿司店造价里「稀有材料」的落点，游戏侧接入前会忽略该键。",
    "source 在文档给定的 surface|dive|npc 之外扩展了一个 craft：由玩家用其它材料制作出来的装备，没有自然产出地。",
    "gameBinding 只对已经在 game.js 里实现的 7 种垃圾存在，用来把数据表锚回代码；其余条目是设计落地，游戏尚未实现，故无此字段。",
    "usage[] 已拆成 usedBy{buildings,recipes,npcs} 三个分类桶——早期把建筑/菜谱/NPC 三种 id 混在一个数组里会让后台无法按类型解析引用，这是有意做的结构修正。",
    "usedBy 是从 buildings.cost / recipes.ingredients / tools.craftCost / npc.recruitCondition 反向推导出来的只读索引，不是手写数据——由 tools/derive-usedby 一步生成，改任何一张表后重跑即可，避免索引与实际数据漂移。",
    "materials 是「垃圾 → 材料 → 建筑」两跳关系的显式中间层。7 种海面垃圾的 usedBy 为空是正确的而非缺数据：它们先被拆解成 wood/plastic/metal，材料才进入建筑造价。后台用 materials 把两跳串起来展示，避免把中间层误读成漏填。"
  ],
  "enums": {
    "category": {
      "material": "建材，拆解后进入木 / 塑 / 铁三线",
      "food": "食材，用于寿司店菜谱",
      "artifact": "遗物，图鉴与叙事收集物",
      "tool": "装备，由玩家制作，不参与拆解"
    },
    "tier": {
      "1": "近岸漂浮物 · 起始海域",
      "2": "洋流带垃圾 · 中距离海域",
      "3": "沉城残骸 · 需潜水",
      "4": "深渊生物 · 深水区"
    },
    "source": {
      "surface": "海面打捞",
      "dive": "潜水采集",
      "npc": "NPC / 市场购入",
      "craft": "玩家制作"
    },
    "yieldKeys": [
      "wood",
      "plastic",
      "metal",
      "food",
      "salvage"
    ],
    "unlockConditionType": {
      "firstPickup": "首次获得即解锁图鉴",
      "buildBuilding": "建成某座建筑后进入刷新池",
      "recruitNpc": "招募某位 NPC 后进入刷新池",
      "progress": "达到某进度门槛后进入刷新池",
      "craftKnown": "拥有对应图纸后可在工作台制作"
    },
    "usedByKeys": {
      "buildings": "直接作为造价材料的建筑 id",
      "recipes": "直接作为食材的菜谱 id",
      "npcs": "与该资源相关的 NPC id（招募条件或特长所需装备）",
      "tools": "与该资源存在工具依赖的装备 id（制作消耗或被它采集/解锁）"
