{
  "schema": "drift-town.buildings",
  "version": 1,
  "updatedAt": "2026-11-22",
  "title": "建筑与设施表",
  "summary": "从阶段 0 的工作台到阶段 4 的寿司店，所有可建造物的造价、前置、产出与位置约束。前置链是本表的重点，后台会据此高亮依赖关系。",
  "sourceOfTruth": {
    "townBuildingsCost": "game.js · BUILDING_SPECS[].cost（6 座城镇建筑，造价不得改动）",
    "townBuildingsPop": "game.js · BUILDING_SPECS[].pop",
    "survivalSteps": "game.js · SURVIVAL_STEPS[] + DEFAULTS.rules.survival.*（workbench/shelter/rainCatcher/fishBasket/scoopNet/purifier 的 needs 与造价）",
    "dependencies": "docs/UNLOCK_CHAIN.md · 二、硬依赖清单（不可并行）"
  },
  "notes": [
    "cost 的单位与 game.js 的 {wood, plastic, metal} 完全同形，额外允许 food / salvage 两个键供寿司店等后期建筑使用；游戏侧遇到未知键会忽略，因此不会破坏当前实现。",
    "buildTime 单位是秒。当前 game.js 中建筑是瞬间落成的（建造动画 1/1.6 秒内收敛），所以现存 6 座 + 6 个生存步骤的 buildTime 取 0 并令 instant=true，表示「与代码一致」；后期建筑给出设计值。",
    "prereq 里的字符串全部是 other buildings 的 id；skill: / npc: 前缀表示技能或 NPC 类前置，后台按前缀分别高亮与校验。",
    "positionRule 沿用文档给的三种枚举（water / land / shore）并扩展 anchor：生存装备是挂在木筏甲板上的小件，不占格，故用 anchor。",
    "output 用「每项都是 {id, amount, text}」的形式，amount 为 null 时表示这是状态型增益（如耐久、声望），量值写在 effect 里。",
    "effectKeys 枚举已补齐：早期版本漏了 survival 类建筑的速率键（waterRate/waterEvery/foodRate/foodEvery）与店铺/检查点类键，后台按枚举校验会误报。"
  ],
  "enums": {
    "positionRule": {
      "water": "必须建在水面（浮岛/筏体上）",
      "land": "必须建在实地上（不适用于纯漂流阶段）",
      "shore": "必须贴着岸边/礁石",
      "anchor": "固定在现成筏体甲板上的小件，不占格"
    },
    "prereqPrefix": {
      "building": "直接写建筑 id",
      "skill": "skill:<branch> 技能分支",
      "npc": "npc:<npcId> 需要该 NPC 已招募",
      "progress": "progress:<key> 进度里程碑"
    },
    "effectKeys": [
      "maxHearts",
      "speed",
      "water",
      "shields",
      "magnet",
      "trade",
      "pop",
      "beds",
      "storage",
      "durability",
      "priceBonus",
      "traffic",
      "unlock",
      "checkpoint",
      "waterRate",
      "waterEvery",
      "foodRate",
      "foodEvery",
      "tradeRatio",
      "menuSlots",
      "menuSlotsMax"
    ]
  },
